---
// Island: Prefix Selector con Autodetección y Límites
---

<div class="space-y-2" id="prefix-wrapper">
  <label class="font-medium text-sm text-foreground">Número de Teléfono</label>
  <div class="flex gap-2">
    <!-- Selector de Prefijo -->
    <div class="relative shrink-0">
      <button
        type="button"
        id="prefix-btn"
        class="h-[50px] flex items-center gap-2 px-3 bg-background border border-border rounded-lg hover:border-primary-500 transition-all focus:outline-none focus:ring-2 focus:ring-primary-500/20"
      >
        <span id="selected-flag" class="text-xl">🇳🇮</span>
        <span id="selected-prefix" class="text-sm font-bold text-foreground"
          >+505</span
        >
        <svg
          id="prefix-chevron"
          class="w-4 h-4 text-muted-foreground transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>

      <!-- Dropdown -->
      <div
        id="prefix-dropdown"
        class="hidden absolute top-full left-0 mt-2 w-64 bg-card border border-border rounded-xl shadow-xl z-50 overflow-hidden"
      >
        <div class="p-2 border-b border-border bg-muted/30">
          <input
            type="text"
            id="prefix-search"
            placeholder="Buscar país o código..."
            class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/50"
          />
        </div>
        <div id="prefix-options" class="max-h-60 overflow-y-auto py-1">
          <!-- Opciones cargadas por JS -->
        </div>
      </div>
    </div>

    <!-- Input de Teléfono -->
    <div class="flex-grow">
      <input
        type="tel"
        id="phone-input"
        name="telefono"
        required
        placeholder="8888 8888"
        class="w-full h-[50px] bg-background border border-border rounded-lg px-4 focus:outline-none focus:ring-2 focus:ring-primary-500/20 transition-all"
      />
    </div>
  </div>

  <!-- Hidden input para enviar el prefijo en el form -->
  <input type="hidden" name="prefijo" id="hidden-prefix" value="+505" />
</div>

<script>
  const COUNTRIES = [
    { flag: "🇺🇸", name: "Estados Unidos", code: "+1", limit: 10 },
    { flag: "🇨🇦", name: "Canadá", code: "+1", limit: 10 },
    { flag: "🇫🇷", name: "Francia", code: "+33", limit: 9 },
    { flag: "🇪🇸", name: "España", code: "+34", limit: 9 },
    { flag: "🇮🇹", name: "Italia", code: "+39", limit: 10 },
    { flag: "🇬🇧", name: "Reino Unido", code: "+44", limit: 10 },
    { flag: "🇩🇪", name: "Alemania", code: "+49", limit: 11 },
    { flag: "🇵🇪", name: "Perú", code: "+51", limit: 9 },
    { flag: "🇲🇽", name: "México", code: "+52", limit: 10 },
    { flag: "🇨🇺", name: "Cuba", code: "+53", limit: 8 },
    { flag: "🇦🇷", name: "Argentina", code: "+54", limit: 10 },
    { flag: "🇧🇷", name: "Brasil", code: "+55", limit: 11 },
    { flag: "🇨🇱", name: "Chile", code: "+56", limit: 9 },
    { flag: "🇨🇴", name: "Colombia", code: "+57", limit: 10 },
    { flag: "🇻🇪", name: "Venezuela", code: "+58", limit: 10 },
    { flag: "🇦🇺", name: "Australia", code: "+61", limit: 9 },
    { flag: "🇯🇵", name: "Japón", code: "+81", limit: 10 },
    { flag: "🇨🇳", name: "China", code: "+86", limit: 11 },
    { flag: "🇵🇹", name: "Portugal", code: "+351", limit: 9 },
    { flag: "🇬🇹", name: "Guatemala", code: "+502", limit: 8 },
    { flag: "🇸🇻", name: "El Salvador", code: "+503", limit: 8 },
    { flag: "🇭🇳", name: "Honduras", code: "+504", limit: 8 },
    { flag: "🇳🇮", name: "Nicaragua", code: "+505", limit: 8 },
    { flag: "🇨🇷", name: "Costa Rica", code: "+506", limit: 8 },
    { flag: "🇵🇦", name: "Panamá", code: "+507", limit: 8 },
    { flag: "🇧🇴", name: "Bolivia", code: "+591", limit: 8 },
    { flag: "🇪🇨", name: "Ecuador", code: "+593", limit: 9 },
    { flag: "🇵🇾", name: "Paraguay", code: "+595", limit: 9 },
    { flag: "🇺🇾", name: "Uruguay", code: "+598", limit: 8 },
    { flag: "🇵🇷", name: "Puerto Rico", code: "+1787", limit: 10 },
    { flag: "🇩🇴", name: "Rep. Dominicana", code: "+1809", limit: 10 },
  ];

  const btn = document.getElementById("prefix-btn")!;
  const dropdown = document.getElementById("prefix-dropdown")!;
  const searchInput = document.getElementById(
    "prefix-search",
  ) as HTMLInputElement;
  const optionsContainer = document.getElementById("prefix-options")!;
  const selectedFlag = document.getElementById("selected-flag")!;
  const selectedPrefix = document.getElementById("selected-prefix")!;
  const hiddenPrefix = document.getElementById(
    "hidden-prefix",
  ) as HTMLInputElement;
  const phoneInput = document.getElementById("phone-input") as HTMLInputElement;
  const chevron = document.getElementById("prefix-chevron")!;

  let activeLimit = 8; // Default Nicaragua

  function updateSelected(country: (typeof COUNTRIES)[0]) {
    selectedFlag.textContent = country.flag;
    selectedPrefix.textContent = country.code;
    hiddenPrefix.value = country.code;
    activeLimit = country.limit;

    phoneInput.placeholder = `Ej: ${"9".repeat(country.limit)}`;
    if (phoneInput.value.length > activeLimit) {
      phoneInput.value = phoneInput.value.slice(0, activeLimit);
    }

    closeDropdown();
  }

  function openDropdown() {
    dropdown.classList.remove("hidden");
    chevron.classList.add("rotate-180");
    searchInput.focus();
    renderOptions();
  }

  function closeDropdown() {
    dropdown.classList.add("hidden");
    chevron.classList.remove("rotate-180");
  }

  async function detectCountry() {
    try {
      const res = await fetch("https://ipapi.co/json/");
      if (!res.ok) return;
      const data = await res.json();

      // Buscar por nombre o código de país (US, NI, etc)
      const country = COUNTRIES.find(
        (c) =>
          c.name.toLowerCase().includes(data.country_name?.toLowerCase()) ||
          (data.country_code === "US" && c.code === "+1") ||
          (data.country_code === "NI" && c.code === "+505"),
      );

      if (country) updateSelected(country);
    } catch (e) {
      console.log("No se pudo detectar país.");
    }
  }

  function renderOptions(filter = "") {
    const q = filter.toLowerCase();
    const filtered = COUNTRIES.filter(
      (c) => c.name.toLowerCase().includes(q) || c.code.includes(q),
    );

    optionsContainer.innerHTML = filtered
      .map(
        (c) => `
            <button type="button" class="country-option w-full flex items-center gap-3 px-4 py-2.5 text-sm hover:bg-muted text-foreground transition-colors" data-code="${c.code}" data-flag="${c.flag}">
                <span class="text-lg">${c.flag}</span>
                <span class="flex-grow text-left">${c.name}</span>
                <span class="text-muted-foreground font-mono">${c.code}</span>
            </button>
        `,
      )
      .join("");

    document.querySelectorAll(".country-option").forEach((opt) => {
      opt.addEventListener("click", () => {
        const code = opt.getAttribute("data-code");
        const flag = opt.getAttribute("data-flag");
        const country = COUNTRIES.find(
          (c) => c.code === code && c.flag === flag,
        );
        if (country) updateSelected(country);
      });
    });
  }

  btn.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdown.classList.contains("hidden") ? openDropdown() : closeDropdown();
  });

  searchInput.addEventListener("input", (e) => {
    renderOptions((e.target as HTMLInputElement).value);
  });

  document.addEventListener("click", (e) => {
    if (
      !document.getElementById("prefix-wrapper")?.contains(e.target as Node)
    ) {
      closeDropdown();
    }
  });

  phoneInput.addEventListener("input", () => {
    let val = phoneInput.value.replace(/\D/g, "");
    if (val.length > activeLimit) val = val.slice(0, activeLimit);
    phoneInput.value = val;
  });

  detectCountry();
  renderOptions();
</script>
